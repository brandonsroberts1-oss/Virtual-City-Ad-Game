# Copy this file to .env and fill in what you need. Everything is optional:
# with no settings the site runs on port 3000 in demo mode (no real payments).

# Port to listen on.
PORT=3000

# Where the SQLite database lives. Keep this folder on a persistent disk.
# DATA_DIR=./data

# Set to "production" when serving over https so cookies are marked Secure.
# NODE_ENV=production

# Set to 1 when running behind a reverse proxy / load balancer so visitor IPs
# (used for rate limiting) are read from X-Forwarded-For.
# TRUST_PROXY=1

# The public address of the site, e.g. https://brandisland.example
# Needed for real payments so buyers are sent back to the right place after paying.
# PUBLIC_URL=

# Real payments: set the keys for ONE processor. With none set the site stays
# in demo mode. No webhook is needed for either.
# STRIPE_SECRET_KEY=sk_live_...
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox            # only while testing with PayPal's sandbox
# PAYMENT_PROVIDER=stripe       # only needed if keys for both are set
# STRIPE_WEBHOOK_SECRET=whsec_... # optional: instant confirmation via webhook

# A long random string. Enables the admin endpoints (remove a property, export
# donations). Leave unset to keep them switched off.
# ADMIN_TOKEN=

# SAMPLE_DATA=on fills the island with made-up sample buildings and donations
# when the site starts (for a preview site) and shows visitors a "preview"
# notice. SAMPLE_DATA=off removes the samples again. Leave unset to do neither.
# SAMPLE_DATA=on
